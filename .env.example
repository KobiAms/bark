# Bark Example Configuration

# Telegram Adapter
# Get your token from @BotFather on Telegram
# TELEGRAM_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Telegram user ID allowlist — only these users can interact with the bot.
# Comma-separated for multiple users. Leave empty to allow anyone (not recommended).
# Get your user ID by messaging @userinfobot on Telegram.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# WhatsApp Adapter
# Standard WhatsApp group name to listen to and reply within
WA_GROUP="PersonalBark"

# Speech-to-Text Plugins (Optional - for Voice Messages)
# Requires: brew install ffmpeg whisper-cpp
# Download a model first:
# mkdir -p /opt/homebrew/share/whisper-cpp/models/
# curl -L https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin -o /opt/homebrew/share/whisper-cpp/models/ggml-base.en.bin
WHISPER_MODEL_PATH="/opt/homebrew/share/whisper-cpp/models/ggml-base.en.bin"
